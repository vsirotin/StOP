{
  "components": [
    {
      "Turnstile": {
        "ts": [
          ["I", "Service Button>Service button pressed", "Locked"],
          ["Locked", "Coin Receiver>Coin inserted", "Weight-checker", "Weight-checker.weightCheck"],
          ["Weight-checker", "Weight-checker>Weight valid", "Form-checker", "Form-checker.checkForm"],
          ["Form-checker", "Form-checker>Form valid, change needed, change available", "Change-dispenser", "Change-dispenser.dispenseChange"],
          ["Change-dispenser", "Change-dispenser>Change dispensed", "Unlocked"],
          ["Unlocked", "Push sensor>User passed through", "Locked"]
        ],
        "components": [
          {
            "Payment component": {
              "components": [
                {
                  "Coin processing component": {
                    "components": [
                      {
                        "Coin Receiver": {
                          "events": [
                            {
                              "coin_inserted": {
                                "description": "User inserts a coin into the coin slot; the coin-receiver receives it.",
                                "signals": [
                                  { "Coin Receiver>Coin inserted": {} }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "Weight-checker": {
                          "commands": [
                            {
                              "Weight-checker.weightCheck": {
                                "description": "Validates the physical weight of the inserted coin.",
                                "signals": [
                                  { "Weight-checker>Weight valid": {} },
                                  { "Weight-checker>Weight invalid": {} }
                                ]
                              }
                            }
                          ],
                          "ts": [
                            ["I", "Coin Receiver>Coin inserted", "Weight Checking"],
                            ["Weight Checking", "Weight-checker>Weight valid", "E_Weight_OK"],
                            ["Weight Checking", "Weight-checker>Weight invalid", "E_Weight_Rejected"]
                          ]
                        }
                      },
                      {
                        "Form-checker": {
                          "commands": [
                            {
                              "Form-checker.checkForm": {
                                "description": "Validates the form (shape/denomination) of the coin and determines whether change is required.",
                                "signals": [
                                  { "Form-checker>Form valid, change needed, change available": {} },
                                  { "Form-checker>Form valid, no change needed": {} },
                                  { "Form-checker>Form valid, change not available": {} },
                                  { "Form-checker>Form invalid": {} }
                                ]
                              }
                            }
                          ],
                          "ts": [
                            ["I", "Weight-checker>Weight valid", "Form Checking"],
                            ["Form Checking", "Form-checker>Form valid, change needed, change available", "E_Form_OK"],
                            ["Form Checking", "Form-checker>Form valid, no change needed", "E_Form_OK"],
                            ["Form Checking", "Form-checker>Form valid, change not available", "E_Form_NoChange"],
                            ["Form Checking", "Form-checker>Form invalid", "E_Form_Rejected"]
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "Change-dispenser": {
              "commands": [
                {
                  "Change-dispenser.dispenseChange": {
                    "description": "Dispenses the required change into the artifact-box.",
                    "signals": [
                      { "Change-dispenser>Change dispensed": {} }
                    ]
                  }
                }
              ],
              "ts": [
                ["I", "Form-checker>Form valid, change needed, change available", "Dispensing"],
                ["Dispensing", "Change-dispenser>Change dispensed", "E_Change_OK"]
              ]
            }
          },
          {
            "Locking mechanism": {
              "components": [
                {
                  "Push sensor": {
                    "events": [
                      {
                        "user_passed_through": {
                          "description": "The push sensor detected that the user pushed through the rotating arm.",
                          "signals": [
                            { "Push sensor>User passed through": {} }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "Service component": {
              "components": [
                {
                  "Service button": {
                    "events": [
                      {
                        "service_button_pressed": {
                          "description": "The service worker pressed the service button to start the turnstile.",
                          "signals": [
                            { "Service Button>Service button pressed": {} }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
