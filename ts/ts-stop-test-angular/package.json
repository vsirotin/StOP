{
  "name": "ts-stop-test-angular",
  "version": "1.0.1",
  "description": "Simple Angular test app to verify the @vsirotin/ts-stop library loads and report its version",
  "private": true,
  "scripts": {
    "build": "ng build",
    "serve": "ng build --no-serve",
    "test": "ng test",
    "check": "npm i && npm run build"
  },
  "dependencies": {
    "@vsirotin/ts-stop": "file:../ts-stop-lib"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "private"
  }
}