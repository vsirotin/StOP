{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "ts-stop-test-angular": {
      "root": ".",
      "projectType": "application",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "outputPath": "dist/ts-stop-test-angular",
            "index": "index.html",
            "tsConfig": "tsconfig.json",
            "assets": [],
            "styles": [],
            "scripts": [],
            "polyfills": ["zone.js"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ts-stop-test-angular:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}