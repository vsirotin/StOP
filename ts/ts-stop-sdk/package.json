{
  "name": "@vsirotin/ts-stop-sdk",
  "version": "3.14.0",
  "description": "State Oriented Programming Software Development Kit — CLI tools, tutorials, skills and Node-only helpers. Depends on @vsirotin/ts-stop.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./sfsm": {
      "types": "./lib/sfsm/index.d.ts",
      "require": "./lib/sfsm/index.js"
    }
  },
  "files": [
    "lib",
    "scripts",
    "ai/skills",
    "tutorial",
    "LICENSE-COMMERCIAL.md",
    "LICENSE-PUBLIC.md",
    "release-notes.md"
  ],
  "bin": {
    "reduce-fa": "./scripts/reduce-fa.js",
    "merge-fas": "./scripts/merge-fas.js",
    "merge-fas-from-dir": "./scripts/merge-fas-from-dir.js",
    "update-full-fa": "./scripts/update-fa.js",
    "update-compact-fa": "./scripts/update-fa.js",
    "run-fa": "./scripts/run-fa.js",
    "validate-fa": "./scripts/validate-fa.js",
    "extract-fa-from-draft": "./scripts/extract-fa-from-draft.js",
    "validate-whole-sfsm": "./scripts/validate-whole-sfsm.js",
    "extract-sfsm": "./scripts/extract-sfsm.js",
    "validate-ext-sfsm": "./scripts/validate-ext-sfsm.js",
    "gen-commands": "./scripts/gen-commands.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf lib coverage",
    "pack": "npm run build && npm pack",
    "reduce-fa": "node scripts/reduce-fa.js",
    "merge-fas": "node scripts/merge-fas.js",
    "merge-fas-from-dir": "node scripts/merge-fas-from-dir.js",
    "update-full-fa": "node scripts/update-fa.js --format=full",
    "update-compact-fa": "node scripts/update-fa.js --format=compact",
    "run-fa": "node scripts/run-fa.js",
    "validate-fa": "node scripts/validate-fa.js",
    "extract-fa-from-draft": "node scripts/extract-fa-from-draft.js",
    "validate-whole-sfsm": "node scripts/validate-whole-sfsm.js",
    "extract-sfsm": "node scripts/extract-sfsm.js",
    "validate-ext-sfsm": "node scripts/validate-ext-sfsm.js",
    "gen-commands": "node scripts/gen-commands.js"
  },
  "keywords": [
    "typescript",
    "state-oriented-programming",
    "stop",
    "sdk"
  ],
  "author": "Viktor Sirotin",
  "license": "(Apache-2.0 OR StOP-Commercial)",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "jest": "^29.5.0",
    "js-yaml": "^4.1.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vsirotin/ts-stop": "file:../ts-stop-lib",
    "elkjs": "^0.12.0",
    "xml2js": "^0.6.2"
  }
}
